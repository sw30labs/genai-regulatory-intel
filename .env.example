# RegIntel — Environment Variables
# ==================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# LLM inference and live web search run through OpenAI Responses API.
# Embeddings run locally via sentence-transformers.

# ── Required ──────────────────────────────────────────────

# OpenAI API key for Responses API calls
OPENAI_API_KEY=your-openai-api-key

# Responses model used for agents and hosted web search
OPENAI_MODEL=gpt-5.5

# ── Optional ──────────────────────────────────────────────

# Optional OpenAI-compatible endpoint override
# OPENAI_BASE_URL=https://api.openai.com/v1

# Override the default database path (~/.regitel/data/regitel.db)
# REGITEL_DB_PATH=~/.regitel/data/regitel.db

# Override the ChromaDB storage path (~/.regitel/data/chroma)
# REGITEL_CHROMA_PATH=~/.regitel/data/chroma

# Override the downloaded documents path (~/.regitel/data/documents)
# REGITEL_DOCUMENTS_PATH=~/.regitel/data/documents

# Logging level (DEBUG, INFO, WARNING, ERROR)
# REGITEL_LOG_LEVEL=INFO
